# Copy to backend/.env and export these before starting the API.
# Never commit real values. The password below is a local placeholder only.

DB_URL=jdbc:postgresql://localhost:5432/cyrohost
DB_USERNAME=cyrohost
DB_PASSWORD=change-me

# At least 32 characters. Example: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=cyrohost

# Public browser origin of the Next.js site. CORS allows this origin only.
FRONTEND_ORIGIN=http://localhost:3000
# Public origin of this API, used as the OAuth redirect base.
PUBLIC_BASE_URL=http://localhost:8080

# true only behind HTTPS. Local HTTP must stay false or browsers drop the cookies.
COOKIE_SECURE=false

# Development only. When true, forgot-password includes devResetToken in the JSON
# response. Leave false in any shared or production environment.
EXPOSE_DEV_RESET_TOKEN=false

# Leave blank until an SMTP provider is configured. Reset mail is skipped when unset.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Admin notices for registration, login, failed login, and VPS requests.
# Mail is skipped, and the request is still saved, when SMTP is blank.
ADMIN_NOTIFICATION_EMAIL=cyrohostsponsorship@gmail.com

# Initial platform admin. The password is read only at startup, hashed with BCrypt,
# and is not written again on later restarts. Leave the password unset to skip creation.
CYROHOST_ADMIN_EMAIL=sunnysharma12@gmail.com
CYROHOST_ADMIN_PASSWORD=
# Set true only to grant ADMIN to an existing account with that email. The password stays as stored.
CYROHOST_ADMIN_UPGRADE=false

# Unused for role assignment. Additional admins are created from Admin → Users / Team.
ADMIN_EMAILS=

# OAuth client credentials. Leave blank until each provider console is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents with literal \n line breaks, or a single-line PKCS8 body.
APPLE_PRIVATE_KEY=
