# Copy to .env for Docker Compose. Never commit .env.
# Placeholder values only. Generate secrets on the server.

# Public browser URL of the API. Baked into the frontend image at build time.
# The browser calls this origin directly. Use the public API origin, not the Docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional. When unset, the contact form says the enquiry was not delivered.
CONTACT_WEBHOOK_URL=

POSTGRES_DB=cyrohost
POSTGRES_USER=cyrohost
POSTGRES_PASSWORD=

# At least 32 characters. Example generation: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=cyrohost

# Public origin of the Next.js site. CORS allows this origin only.
FRONTEND_ORIGIN=http://localhost:3000
# Public origin of the API, used as the OAuth redirect base.
PUBLIC_BASE_URL=http://localhost:8080

# true when the site is served over HTTPS.
COOKIE_SECURE=false
# none, native, or framework. Use framework only behind a trusted reverse proxy.
SERVER_FORWARD_HEADERS=none
EXPOSE_DEV_RESET_TOKEN=false

# Host ports. PostgreSQL is not published.
BACKEND_PUBLISH_PORT=8080
FRONTEND_PUBLISH_PORT=3000

# Leave blank until SMTP is configured. Requests are still saved when mail is unset.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=cyrohostsponsorship@gmail.com

# Initial admin. Leave the password empty to skip creation. It is hashed once and not reset on restart.
CYROHOST_ADMIN_EMAIL=
CYROHOST_ADMIN_PASSWORD=
CYROHOST_ADMIN_UPGRADE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Production image references. Jenkins writes these on the server. Leave blank for a local build.
CYROHOST_BACKEND_IMAGE=
CYROHOST_FRONTEND_IMAGE=
